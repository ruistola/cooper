# Strings and arrays: building many small strings, joining, and growing arrays.
use {
    std.io,
    std.strings,
}

func main() {
    total := 0
    for round in 0..60 do {
        let parts: string[]
        for i in 0..20000 do parts.push("item {i} of round {round}")
        text := strings.join(parts, ",")
        total += text.length()
        pieces := text.split(",")
        total += pieces.length()
    }
    io.println("{total}")
}
