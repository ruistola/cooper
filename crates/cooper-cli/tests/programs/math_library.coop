# exit: 0
# stdout: 3 2.5 10 0 7 0
# stdout: 1.4142135 1.4142135623730951 2 1024 1 3.1415927
# stdout: -2 -1 3 -3 -2 2.5
# stdout: true false true false true
# stdout: nan nan b
# stdout: [1, 2, 3] 3.1415927
use {
    std.io,
    std.math,
}

# Generic code may pass its own type parameter on to the float functions, and use literals of it.
func circleArea T (r: T): T {
    return 3.141592653589793 * math.pow(r, 2)
}

func main() {
    io.println("{math.min(3, 4)} {math.max(2.5, 1.5)} {math.clamp(15, 0, 10)} {math.clamp(-5, 0, 10)} {math.abs(-7)} {math.abs(-0.0)}")
    # An integer literal a float function takes is a float.
    io.println("{math.sqrt(2.0)} {math.sqrt(f64(2))} {math.sqrt(4)} {math.pow(2.0, 10.0)} {math.sin(math.Pi / 2.0)} {math.atan2(1.0, 1.0) * 4.0}")
    io.println("{math.floor(-1.5)} {math.ceil(-1.5)} {math.round(2.5)} {math.round(-2.5)} {math.trunc(-2.7)} {math.hypot(1.5, 2.0)}")
    io.println("{math.isNaN(math.NaN)} {math.isNaN(1.0)} {math.isInf(-math.Inf)} {math.isFinite(math.Inf)} {math.isFinite(f32(3))}")
    io.println("{math.min(math.NaN, 1.0)} {math.min(1.0, math.NaN)} {math.max('a', 'b')}")
    xs := [1.0, 4.0, 9.0].map(math.sqrt)
    io.println("{xs} {circleArea(f32(1))}")
}
