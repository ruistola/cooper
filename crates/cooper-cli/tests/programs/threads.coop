# exit: 0
# stdout: main waits
# stdout: 8 turns logged, a2 after a0
# stdout: arguments are evaluated at the thread: 5 7 x
# stdout: slow after fast
# stdout: handles 1 2 ok
# stdout: 1000 threads counted 2000
# stdout: 50000
# stdout: 3 5 ab
# Threads started with `thread`: they run in parallel, and data they share is guarded (a `Mutex`) or atomic.
# A `thread` evaluates its function and arguments at once,
# works with functions, methods (a pointer receiver on a local variable keeps that variable), function
# values, and generic functions, and gives a `Thread` handle. A thread's stack is its own, as large as an
# OS thread's (8 MiB, committed as used): here one recurses 50000 frames deep, and a thousand threads exist
# at once.
use {
    std.io.println,
    std.threads.{ sleep, yield },
    std.sync.{ Atomic, Mutex, WaitGroup },
}

struct Counter {
    total: Atomic,
}

(c: Counter^) func add(n: i64) {
    c.total.add(n)
}

func worker(name: string, rounds: i32, wg: WaitGroup^, m: Mutex^, log: string[]^) {
    for i in 0..rounds do {
        m.lock()
        log.push("{name}{i}")
        m.unlock()
        yield()
    }
    wg.done()
}

func show(label: string, a: i32, b: i32, wg: WaitGroup^) {
    println("{label}: {a} {b} x")
    wg.done()
}

func nap(label: string, ms: i64, wg: WaitGroup^, m: Mutex^, order: string[]^) {
    sleep(ms)
    m.lock()
    order.push(label)
    m.unlock()
    wg.done()
}

func count(counter: Counter^, wg: WaitGroup^) {
    counter.add(1)
    yield()
    counter.add(1)
    wg.done()
}

func depth(n: i64): i64 {
    if n == 0 then return 0
    return depth(n - 1) + 1
}

func recurse(result: i64^, wg: WaitGroup^) {
    result^ = depth(50000)
    wg.done()
}

func echo T (value: T, out: T^, wg: WaitGroup^) {
    out^ = value
    wg.done()
}

func main() {
    let wg: WaitGroup
    let m: Mutex
    let log: string[]
    wg.add(3)
    thread worker("a", 3, &wg, &m, &log)
    thread worker("b", 2, &wg, &m, &log)
    thread worker("c", 3, &wg, &m, &log)
    println("main waits")
    wg.wait()
    let a0 = -1
    let a2 = -1
    for (i, entry) in log do {
        if entry == "a0" then a0 = i
        if entry == "a2" then a2 = i
    }
    println("{log.length()} turns logged, {if a2 > a0 then "a2 after a0" else "out of order"}")

    x := 5
    wg.add(1)
    thread show("arguments are evaluated at the thread", x, x + 2, &wg)
    x = 99
    wg.wait()

    let order: string[]
    wg.add(2)
    thread nap("slow", 40, &wg, &m, &order)
    thread nap("fast", 10, &wg, &m, &order)
    wg.wait()
    println("{order[1]} after {order[0]}")

    # each thread has its own handle, with an id that grows
    wg.add(2)
    first := thread nap("one", 0, &wg, &m, &order)
    second := thread nap("two", 0, &wg, &m, &order)
    wg.wait()
    println("handles 1 2 {if second.id == first.id + 1 and first.id > 0 then "ok" else "wrong"}")

    let counter: Counter
    wg.add(1000)
    for i in 0..1000 do thread count(&counter, &wg)
    wg.wait()
    println("1000 threads counted {counter.total.load()}")

    let deep: i64
    wg.add(1)
    thread recurse(&deep, &wg)
    wg.wait()
    println("{deep}")

    let three: i32
    let five: i32
    let word: string
    wg.add(3)
    thread echo(3, &three, &wg)
    thread echo(5, &five, &wg)
    thread echo("ab", &word, &wg)
    wg.wait()
    println("{three} {five} {word}")
}
