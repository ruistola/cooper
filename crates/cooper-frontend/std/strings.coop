# The standard `strings` module: the methods of `string`, and string building, written in
# Cooper. Everything works in byte offsets, which are the offsets slicing takes; a match of
# valid UTF-8 text in valid UTF-8 text always starts on a rune boundary. Case mapping is
# ASCII only for now.

# A string under construction: bytes appended in amortized constant time.
struct StringBuilder {
    bytes: u8[],
}

(b: StringBuilder^) func write(s: string) {
    for i in 0..s.length() do b.bytes = b.bytes.push(s.byteAt(i))
}

# Appends the UTF-8 encoding of a rune.
(b: StringBuilder^) func writeRune(r: rune) {
    c := u32(r)
    if c < 0x80 then {
        b.bytes = b.bytes.push(u8(c))
    } else if c < 0x800 then {
        b.bytes = b.bytes.push(u8(0xC0 or c >> 6))
        b.bytes = b.bytes.push(u8(0x80 or c and 0x3F))
    } else if c < 0x10000 then {
        b.bytes = b.bytes.push(u8(0xE0 or c >> 12))
        b.bytes = b.bytes.push(u8(0x80 or c >> 6 and 0x3F))
        b.bytes = b.bytes.push(u8(0x80 or c and 0x3F))
    } else {
        b.bytes = b.bytes.push(u8(0xF0 or c >> 18))
        b.bytes = b.bytes.push(u8(0x80 or c >> 12 and 0x3F))
        b.bytes = b.bytes.push(u8(0x80 or c >> 6 and 0x3F))
        b.bytes = b.bytes.push(u8(0x80 or c and 0x3F))
    }
}

(b: StringBuilder) func length(): i64 {
    return b.bytes.length()
}

# The text built so far.
(b: StringBuilder) func build(): string {
    return if b.bytes.utf8() is Some(text) then text else ""
}

# The parts joined with `sep` between them.
func join(parts: string[], sep: string): string {
    let out: StringBuilder
    for (i, part) in parts do {
        if i > 0 then out.write(sep)
        out.write(part)
    }
    return out.build()
}

# The offset of the first occurrence of `sub`, if any. To search on from an offset, slice:
# `s[from..].find(sub)` is relative to the slice.
(s: string) func find(sub: string): Maybe i64 {
    m := sub.length()
    for i in 0..=s.length() - m do {
        j := 0
        while j < m and s.byteAt(i + j) == sub.byteAt(j) do j += 1
        if j == m then return Some(i)
    }
    return None
}

(s: string) func contains(sub: string): bool {
    return s.find(sub) is Some(_)
}

(s: string) func startsWith(prefix: string): bool {
    if prefix.length() > s.length() then return false
    for i in 0..prefix.length() do if s.byteAt(i) != prefix.byteAt(i) then return false
    return true
}

(s: string) func endsWith(suffix: string): bool {
    skip := s.length() - suffix.length()
    if skip < 0 then return false
    for i in 0..suffix.length() do if s.byteAt(skip + i) != suffix.byteAt(i) then return false
    return true
}

func isSpace(c: u8): bool {
    return c == 32 or 9 <= c <= 13
}

# Without leading ASCII whitespace.
(s: string) func trimStart(): string {
    i := 0
    while i < s.length() and isSpace(s.byteAt(i)) do i += 1
    return s[i..]
}

# Without trailing ASCII whitespace.
(s: string) func trimEnd(): string {
    j := s.length()
    while j > 0 and isSpace(s.byteAt(j - 1)) do j -= 1
    return s[..j]
}

(s: string) func trim(): string {
    return s.trimStart().trimEnd()
}

# The pieces of `s` between occurrences of `sep`; with an empty `sep`, its runes.
(s: string) func split(sep: string): string[] {
    let parts: string[]
    if sep.length() == 0 then {
        for (i, r) in s do {
            let one: StringBuilder
            one.writeRune(r)
            parts = parts.push(one.build())
        }
        return parts
    }
    start := 0
    while s[start..].find(sep) is Some(i) do {
        parts = parts.push(s[start..start + i])
        start += i + sep.length()
    }
    return parts.push(s[start..])
}

# `s` with every occurrence of `old` replaced by `new`; unchanged when `old` is empty.
(s: string) func replace(old: string, new: string): string {
    if old.length() == 0 then return s
    let result: StringBuilder
    offset := 0
    while s[offset..].find(old) is Some(idx) do {
        result.write(s[offset..offset + idx])
        result.write(new)
        offset += idx + old.length()
    }
    result.write(s[offset..])
    return result.build()
}

# `s` `n` times over (`repeat` is a keyword); empty when `n` is not positive.
(s: string) func times(n: i64): string {
    let out: StringBuilder
    for _ in 0..n do out.write(s)
    return out.build()
}

# ASCII letters lowercased; everything else unchanged.
(s: string) func toLower(): string {
    let out: StringBuilder
    for r in s do out.writeRune(if 'A' <= r <= 'Z' then rune(u32(r) + 32) else r)
    return out.build()
}

# ASCII letters uppercased; everything else unchanged.
(s: string) func toUpper(): string {
    let out: StringBuilder
    for r in s do out.writeRune(if 'a' <= r <= 'z' then rune(u32(r) - 32) else r)
    return out.build()
}
