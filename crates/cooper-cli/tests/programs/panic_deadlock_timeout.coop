# exit: 101
# stdout: released
# stderr: panic: all threads are blocked: deadlock
# A sync that committed before its timeout leaves no timer behind: the deadlock that follows is found at
# once, not when the 1000 s timeout would have passed.
use {
    std.io,
    std.sync,
    std.threads,
}

func release(latch: sync.Latch^) {
    threads.sleep(10)
    latch.release()
}

func main() {
    let latch: sync.Latch
    thread release(&latch)
    sync.wait(sync.choose(latch.releasedEvent(), sync.after(1000000)))
    io.println("released")
    let wg: sync.WaitGroup
    wg.add(1)
    wg.wait()
}
