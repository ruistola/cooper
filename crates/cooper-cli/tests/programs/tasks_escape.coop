# exit: 0
# stdout: arr 3
# stdout: n = 42
# Values a started task uses live on past the function that started it, and so are on the heap.
use { std.io.println, std.task.sleep, std.sync.WaitGroup }
func work(n: i64^, wg: WaitGroup^) {
    sleep(5)
    println("n = {n^}")
    wg.done()
}
func start(wg: WaitGroup^) {
    let n: i64 = 42
    let arr: i64[3] = [1, 2, 3]
    f := func() { println("arr {arr[2]}") }
    co work(&n, wg)
    co f()
}
func main() {
    let wg: WaitGroup
    wg.add(1)
    start(&wg)
    let junk: i64[512]
    junk[1] = 7
    sleep(20)
    wg.wait()
}
