# exit: 0
# stdout: [10, 20, 30] [0, 0, 0, 0] 3
# stdout: 10 99
# stdout: 10 5
# stdout: [100, 2, 3, 4] [100, 2, 3, 4, 5] [100, 2, 3, 4]
# stdout: 14
# stdout: [200, 4, 6, 8] [100, 2, 3, 4]
# stdout: 8
# stdout: [[2, 0, 0], [0, 0, 5]] 2 3
# stdout: [[2, 0, 0], [4, 0, 5]]
# stdout: Pixel{rgb: [0, 200, 7], tag: 0} [0, 200, 7]
# stdout: [100, 2, 55, 4]
# stdout: 1
# Static arrays `T[N]`: zero values, array literals checked against the length, copying on
# assignment and when passed or returned, indexing and `for`, `length()`, slicing to share
# the elements as a `T[]` (whose `push` leaves the array alone), arrays inside structs and
# of arrays (`i32[3][2]` is two rows of three), and pointers to elements.
use {
  std.io.println,
}

struct Pixel {
  rgb: u8[3],
  tag: i32,
}

func sum(xs: i32[]): i32 {
  total := 0
  for x in xs do total += x
  return total
}

func dot(a: f32[3], b: f32[3]): f32 {
  total := 0.0
  for i in 0..3 do total += a[i] * b[i]
  return total
}

func double(a: i32[4]): i32[4] {
  out := a
  for (i, v) in a do out[i] = v * 2
  return out
}

func fill(): i32[3] {
  return [7, 8, 9]
}

func main() {
  let rgb: u8[3] = [10, 20, 30]
  let zero: i32[4]
  println("{rgb} {zero} {rgb.length()}")
  b := rgb
  b[0] = 99
  println("{rgb[0]} {b[0]}")
  let nums: i32[4] = [1, 2, 3, 4]
  println("{sum(nums[..])} {sum(nums[1..3])}")
  view := nums[..]
  view[0] = 100
  println("{nums} {view.push(5)} {nums}")
  let v1: f32[3] = [1.0, 2.0, 3.0]
  println("{dot(v1, v1)}")
  println("{double(nums)} {nums}")
  println("{fill()[1]}")
  let grid: i32[3][2]
  grid[1][2] = 5
  grid[0][0] += 2
  println("{grid} {grid.length()} {grid[1].length()}")
  row := grid[1][..]
  row[0] = 4
  println("{grid}")
  let px: Pixel
  px.rgb[1] = 200
  p := &px
  p.rgb[2] = 7
  println("{px} {px.rgb[..]}")
  q := &nums[2]
  q^ = 55
  println("{nums}")
  let big: i64[1000]
  big[999] = 1
  println("{big[999] + big[0]}")
}
