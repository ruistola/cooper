# exit: 0
# stdout: a, b, c
# stdout: |
# stdout: x-y
# A standard library module written in Cooper (`std.strings`), compiled with the program
# that uses it. Functions `main` never reaches are not compiled.
use {
    std.io,
    std.strings,
}

func unused() {
    io.println("never compiled")
}

func main() {
    io.println(strings.join(["a", "b", "c"], ", "))
    io.println(strings.join([], "-") + "|")
    io.println(strings.join(["x", "y"], "-"))
}
