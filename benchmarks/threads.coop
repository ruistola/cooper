# Scheduler costs: two threads switching back and forth, a million short-lived threads, and a large
# number of threads alive at once, each holding a stack.
use {
    std.io,
    std.threads,
    std.sync,
}

func ping(n: i32, wg: sync.WaitGroup^) {
    for i in 0..n do threads.yield()
    wg.done()
}

func noop(wg: sync.WaitGroup^) {
    wg.done()
}

func hold(wg: sync.WaitGroup^) {
    threads.sleep(200)
    wg.done()
}

func main() {
    let wg: sync.WaitGroup
    wg.add(2)
    thread ping(2500000, &wg)
    thread ping(2500000, &wg)
    wg.wait()
    io.println("5M switches")

    for round in 0..1000 do {
        wg.add(1000)
        for i in 0..1000 do thread noop(&wg)
        wg.wait()
    }
    io.println("1M threads")

    wg.add(100000)
    for i in 0..100000 do thread hold(&wg)
    wg.wait()
    io.println("100k threads alive at once")
}
