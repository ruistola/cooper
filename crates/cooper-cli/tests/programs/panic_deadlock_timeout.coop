# exit: 101
# stdout: released
# stderr: panic: all threads are blocked: deadlock
# A sync that committed before its timeout leaves no timer behind: the deadlock that follows is found at
# once, not when the 1000 s timeout would have passed.
use {
    std.io.println,
    std.sync.{ Latch, WaitGroup, after, choose, sync },
    std.threads.sleep,
}

func release(latch: Latch^) {
    sleep(10)
    latch.release()
}

func main() {
    let latch: Latch
    thread release(&latch)
    sync(choose(latch.releasedEvent(), after(1000000)))
    println("released")
    let wg: WaitGroup
    wg.add(1)
    wg.wait()
}
