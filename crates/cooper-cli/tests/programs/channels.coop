# exit: 0
# stdout: sum 4950
# stdout: ping pong 3
# stdout: closed after 5, got 10
# stdout: counter 400
use {
    std.io,
    std.sync,
    std.threads,
}

func produce(ch: (sync.Channel i32)^, from: i32, to: i32) {
    for i in from..to do ch.send(i)
}

func bump(m: sync.Mutex^, counter: i64^, wg: sync.WaitGroup^) {
    for i in 0..100 do {
        m.lock()
        let seen = counter^
        threads.yield()
        counter^ = seen + 1
        m.unlock()
    }
    wg.done()
}

func value(m: Maybe i32): i32 {
    return match m with {
        Some(v) => v
        None => 0
    }
}

func relay(ping: (sync.Channel i32)^, pong: (sync.Channel i32)^) {
    for i in 0..3 do pong.send(value(ping.recv()) + 1)
}

func main() {
    # unbuffered channel, two producers, one consumer
    numbers := sync.channel(0)
    thread produce(&numbers, 0, 50)
    thread produce(&numbers, 50, 100)
    total := 0
    for i in 0..100 do match numbers.recv() with {
        Some(v) => total += v
        None => io.println("unexpected close")
    }
    io.println("sum {total}")

    # two threads taking turns over a pair of channels
    ping := sync.channel(0)
    pong := sync.channel(0)
    thread relay(&ping, &pong)
    r := 0
    for i in 0..3 do {
        ping.send(r)
        r = value(pong.recv())
    }
    io.println("ping pong {r}")

    # buffered channel, closed
    buf := sync.channel(8)
    for i in 0..5 do buf.send(i)
    buf.close()
    n := 0
    sum := 0
    while true do match buf.recv() with {
        Some(v) => { n += 1; sum += v }
        None => break
    }
    io.println("closed after {n}, got {sum}")

    # a mutex around a read-yield-write
    let m: sync.Mutex
    counter := 0
    let wg: sync.WaitGroup
    wg.add(4)
    for i in 0..4 do thread bump(&m, &counter, &wg)
    wg.wait()
    io.println("counter {counter}")
}
