# exit: 0
# stdout: llo
# C interop with the C library: scalar arguments and results, a pointer into a Cooper
# array, a C function used as a value, a struct returned by value (`div_t`), and
# `CString` conversions in both directions, including a char pointer C returns.
use { std.io as io, std.ffi.{ CString, copyBytes } }

struct DivT { quot: i32, rem: i32 }

extern func abs(v: i32): i32
extern func strlen(s: u8^): u64
extern func strchr(s: CString, c: i32): CString
extern func div(a: i32, b: i32): DivT

func apply(f: func(i32): i32, v: i32): i32 { return f(v) }

func main(): i32 {
    if abs(-9) != 9 or apply(abs, -3) != 3 then return 1
    let bytes: u8[] = [104, 105, 0]
    if strlen(&bytes[0]) != 2 then return 2
    d := div(17, 5)
    if d.quot != 3 or d.rem != 2 then return 3
    c := CString("hello")
    if strlen(c.data) != 5 then return 4
    io.println(string(strchr(c, 108)))
    copy := copyBytes(c.data, 2)
    if copy.length() != 2 or copy[1] != 101 then return 5
    let none: CString
    if string(none) != "" then return 6
    return 0
}
