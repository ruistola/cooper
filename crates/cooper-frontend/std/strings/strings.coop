# The standard `strings` module: the methods of `string`, and string building, written in
# Cooper. Everything works in byte offsets, which are the offsets slicing takes; a match of
# valid UTF-8 text in valid UTF-8 text always starts on a rune boundary. Case mapping is
# ASCII only, and named so.

(b: Builder^) func write(s: string) {
    for i in 0..s.length() do b.bytes.push(s.byteAt(i))
}

# Appends the UTF-8 encoding of a rune.
(b: Builder^) func writeRune(r: rune) {
    c := u32(r)
    if c < 0x80 then {
        b.bytes.push(u8(c))
    } else if c < 0x800 then {
        b.bytes.push(u8(0xC0 or c >> 6))
        b.bytes.push(u8(0x80 or c and 0x3F))
    } else if c < 0x10000 then {
        b.bytes.push(u8(0xE0 or c >> 12))
        b.bytes.push(u8(0x80 or c >> 6 and 0x3F))
        b.bytes.push(u8(0x80 or c and 0x3F))
    } else {
        b.bytes.push(u8(0xF0 or c >> 18))
        b.bytes.push(u8(0x80 or c >> 12 and 0x3F))
        b.bytes.push(u8(0x80 or c >> 6 and 0x3F))
        b.bytes.push(u8(0x80 or c and 0x3F))
    }
}

(b: Builder) func length(): i64 {
    return b.bytes.length()
}

# The text built so far.
(b: Builder) func build(): string {
    return if b.bytes.utf8() is Some(text) then text else ""
}

# The parts joined with `sep` between them.
func join(parts: string[], sep: string): string {
    let sb: Builder
    for (i, part) in parts do {
        if i > 0 then sb.write(sep)
        sb.write(part)
    }
    return sb.build()
}

# The offset of the first occurrence of `sub`, if any. To search on from an offset, slice:
# `s[from..].find(sub)` is relative to the slice.
(s: string) func find(sub: string): Maybe i64 {
    m := sub.length()
    for i in 0..=s.length() - m do {
        j := 0
        while j < m and s.byteAt(i + j) == sub.byteAt(j) do j += 1
        if j == m then return Some(i)
    }
    return None
}

(s: string) func contains(sub: string): bool {
    return s.find(sub) is Some(_)
}

(s: string) func startsWith(prefix: string): bool {
    if prefix.length() > s.length() then return false
    for i in 0..prefix.length() do if s.byteAt(i) != prefix.byteAt(i) then return false
    return true
}

(s: string) func endsWith(suffix: string): bool {
    skip := s.length() - suffix.length()
    if skip < 0 then return false
    for i in 0..suffix.length() do if s.byteAt(skip + i) != suffix.byteAt(i) then return false
    return true
}

# Without leading ASCII whitespace.
(s: string) func trimStart(): string {
    i := 0
    while i < s.length() and isSpace(s.byteAt(i)) do i += 1
    return s[i..]
}

# Without trailing ASCII whitespace.
(s: string) func trimEnd(): string {
    j := s.length()
    while j > 0 and isSpace(s.byteAt(j - 1)) do j -= 1
    return s[..j]
}

(s: string) func trim(): string {
    return s.trimStart().trimEnd()
}

# The pieces of `s` between occurrences of `sep`; with an empty `sep`, its runes.
(s: string) func split(sep: string): string[] {
    let parts: string[]
    if sep.length() == 0 then {
        for (i, r) in s do {
            let sb: Builder
            sb.writeRune(r)
            parts.push(sb.build())
        }
        return parts
    }
    start := 0
    while s[start..].find(sep) is Some(i) do {
        parts.push(s[start..start + i])
        start += i + sep.length()
    }
    parts.push(s[start..])
    return parts
}

# `s` with every occurrence of `old` replaced by `new`; unchanged when `old` is empty.
(s: string) func replace(old: string, new: string): string {
    if old.length() == 0 then return s
    let sb: Builder
    offset := 0
    while s[offset..].find(old) is Some(idx) do {
        sb.write(s[offset..offset + idx])
        sb.write(new)
        offset += idx + old.length()
    }
    sb.write(s[offset..])
    return sb.build()
}

# `s` with spaces before it to make it `width` runes long, as the `{s:>8}` hole aligns it; `s`
# itself when it is at least that long.
(s: string) func padStart(width: i64): string {
    return " ".times(width - runeCount(s)) + s
}

# `s` with spaces after it to make it `width` runes long, as the `{s:<8}` hole aligns it; `s`
# itself when it is at least that long.
(s: string) func padEnd(width: i64): string {
    return s + " ".times(width - runeCount(s))
}

# `s` `n` times over (`repeat` is a keyword); empty when `n` is not positive.
(s: string) func times(n: i64): string {
    let sb: Builder
    for _ in 0..n do sb.write(s)
    return sb.build()
}

# ASCII letters lowercased; everything else unchanged.
(s: string) func toAsciiLower(): string {
    let sb: Builder
    for r in s do sb.writeRune(r.toAsciiLower())
    return sb.build()
}

# ASCII letters uppercased; everything else unchanged.
(s: string) func toAsciiUpper(): string {
    let sb: Builder
    for r in s do sb.writeRune(r.toAsciiUpper())
    return sb.build()
}

# The integer `s` spells in decimal, with an optional sign: `Some(-42)` for "-42". Anything
# else is `None`, spaces and `_` included, and so is a number outside the range of `i64`. For
# a narrower type, convert the result: `if s.parseInt() is Some(n) and n.toI32() is Some(m)`.
(s: string) func parseInt(): Maybe i64 {
    const Min: i64 = -9223372036854775808
    negative := s.startsWith("-")
    start := if negative or s.startsWith("+") then 1 else 0
    if start == s.length() or digitsEnd(s, start) != s.length() then return None
    # Accumulated as a negative number, since `Min` has no positive counterpart.
    let n: i64 = 0
    for i in start..s.length() do {
        d := i64(s.byteAt(i) - u8('0'))
        if n < (Min + d) / 10 then return None
        n = n * 10 - d
    }
    if negative then return Some(n)
    return if n == Min then None else Some(-n)
}

# The `f64` nearest to the number `s` spells in decimal, with an optional sign, fraction, and
# exponent: "2.5", "-.5", "1e9", "6.02E-23". "inf", "-inf", and "nan", as `string(f)` writes
# them, are accepted too. Anything else is `None`, spaces and `_` included, and so is a number
# too large for an `f64`.
(s: string) func parseFloat(): Maybe f64 {
    start := if s.startsWith("-") or s.startsWith("+") then 1 else 0
    if s[start..] == "inf" or s[start..] == "nan" then return Some(cFloat(s))
    whole := digitsEnd(s, start)
    end := whole
    if end < s.length() and s.byteAt(end) == u8('.') then end = digitsEnd(s, end + 1)
    # A digit is needed before or after the point.
    if whole == start and end <= start + 1 then return None
    if end < s.length() and (s.byteAt(end) == u8('e') or s.byteAt(end) == u8('E')) then {
        exponent := end + 1
        if exponent < s.length() and (s.byteAt(exponent) == u8('-') or s.byteAt(exponent) == u8('+')) then exponent += 1
        end = digitsEnd(s, exponent)
        if end == exponent then return None
    }
    if end != s.length() then return None
    f := cFloat(s)
    # Only an infinity has no difference from itself that is zero.
    return if f - f == 0.0 then Some(f) else None
}
