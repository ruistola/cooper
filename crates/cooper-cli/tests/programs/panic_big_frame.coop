# exit: 101
# stderr: panic: stack overflow in thread
# A local array larger than the guard page must not step over it: the frame is probed a page at a
# time, so the overflow is caught instead of corrupting whatever lies below the stack.
use {
    std.sync.WaitGroup,
}

extern func getpid(): i32

# The indexes depend on the process id, so that an optimized build keeps the array.
func big(): i64 {
    let a: i64[3000000]
    a[i64(getpid()) % 3000000] = 7
    return a[i64(getpid()) * 7 % 3000000]
}

func run(wg: WaitGroup^) {
    big()
    wg.done()
}

func main() {
    let wg: WaitGroup
    wg.add(1)
    thread run(&wg)
    wg.wait()
}
