# exit: 0
# stdout: Ok(9) Err("step b: bad") Err("step a: bad")
# stdout: Some(8) None
# stdout: 102
# stdout: logged 7
# stdout: missing
# Divergence in expression position: `return`, `break`, and `continue` as the arm of a
# `match` or the branch of an `if` expression, alone or ending a braced block. They fit
# any type, so a failed step leaves early while a successful one yields its value.
use {
    std.io,
}

func read(n: i32): Result i32 string {
    if n > 0 then return Ok(n)
    return Err("bad")
}

# Each step wraps its error with context on the way out.
func load(n: i32): Result i32 string {
    a := match read(n) with {
        Ok(v) => v
        Err(err) => return Err("step a: {err}")
    }
    b := match read(a - 1) with { Ok(v) => v; Err(err) => return Err("step b: {err}") }
    return Ok(a + b)
}

func double(m: Maybe i32): Maybe i32 {
    x := if m is Some(x) then x else return None
    return Some(x * 2)
}

func loop(): i32 {
    total := 0
    for i in 0..4 do {
        n := if i == 1 then continue else i
        m := if n == 3 then { total += 100; break } else n
        total += m
    }
    return total
}

func logged(m: Maybe i32): i32 {
    x := if m is Some(x) then x else {
        std.io.println("missing")
        return -1
    }
    std.io.println("logged {x}")
    return x
}

func main() {
    std.io.println("{load(5)} {load(1)} {load(0)}")
    std.io.println("{double(Some(4))} {double(None)}")
    std.io.println("{loop()}")
    logged(Some(7))
    logged(None)
}
