# exit: 0
# stdout: x 120 é 26085 😀 ' " }
# stdout: true true true
# stdout: λ A
# stdout: ['x', 'y'] Tok{c: 'q', n: 1} ['\n', '\\']
# stdout: 0: h
# stdout: 1: é
# stdout: 3: l
# stdout: 4: l
# stdout: 5: o
# stdout: 6: ,
# stdout: 7:  
# stdout: 8: 日
# stdout: 11: 本
# stdout: 14: !
# stdout: 10 15
# stdout: letter a newline han other
# stdout: 0 true
# stdout: is x
# stdout:   x|**x**
# `rune`, a Unicode scalar value: literals with escapes (including quote and brace
# characters in a string hole), comparison and chains, conversions to and from integers,
# formatting bare and inside values, `match` and `is` patterns, and `for` over a string,
# which yields each rune and the byte offset it starts at.
use {
    std.io.println,
}

struct Tok {
    c: rune,
    n: i32,
}

func kind(r: rune): string {
    return match r with {
        'a' => "letter a"
        '\n' => "newline"
        '日' => "han"
        _ => "other"
    }
}

func main() {
    r := 'x'
    println("{r} {u32(r)} {'é'} {u32('日')} {'\u{1F600}'} {'\''} {'"'} {'}'}")
    println("{'a' < 'b'} {r == 'x'} {'a' <= r <= 'z'}")
    println("{rune(955)} {rune(u8(65))}")
    println("{[r, 'y']} {Tok{c: 'q', n: 1}} {['\n', '\\']}")
    s := "héllo, 日本!"
    for (i, c) in s do println("{i}: {c}")
    count := 0
    for c in s do count += 1
    println("{count} {s.length()}")
    println("{kind('a')} {kind('\n')} {kind('日')} {kind('z')}")
    let zero: rune
    println("{u32(zero)} {zero == '\0'}")
    if r is 'x' then println("is x")
    println("{r:>3}|{r:*^5}")
}
