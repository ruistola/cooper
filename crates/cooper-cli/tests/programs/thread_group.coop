# exit: 0
# stdout: all 5 done
# stdout: error: disk full
# stdout: stopped early: true
# stdout: error: none
# stdout: worker handled 2 jobs, then stopped
use {
    std.io.println,
    std.sync.{ Atomic, Channel, ThreadGroup, channel, choose, sync, wrap },
    std.threads.{ sleep, yield },
}

func report(e: Maybe string) {
    match e with {
        Some(m) => println("error: {m}")
        None => println("error: none")
    }
}

func main() {
    # every thread finishes before wait returns
    let group: ThreadGroup
    let finished: Atomic
    for i in 0..5 do group.start(func() {
        sleep(2 * i)
        finished.add(1)
    })
    group.wait()
    println("all {finished.load()} done")

    # a failure cancels the rest, which check and stop
    let failing: ThreadGroup
    let steps: Atomic
    failing.start(func() {
        sleep(3)
        failing.fail("disk full")
    })
    for i in 0..3 do failing.start(func() {
        while !failing.cancelled() do {
            steps.add(1)
            sleep(1)
        }
    })
    report(failing.wait())
    println("stopped early: {steps.load() < 100}")

    # a group with no failure
    let quiet: ThreadGroup
    quiet.start(func() { yield() })
    report(quiet.wait())

    # a member blocked on a channel stops when the group is cancelled
    let workers: ThreadGroup
    let jobs: Channel i32 = channel(0)
    handled := 0
    workers.start(func() {
        stopped := wrap(workers.cancelledEvent(), func(c: ()): Maybe i32 { return None })
        while sync(choose(jobs.recvEvent(), stopped)) is Some(job) do handled += 1
    })
    jobs.send(1)
    jobs.send(2)
    workers.cancel()
    workers.wait()
    println("worker handled {handled} jobs, then stopped")
}
