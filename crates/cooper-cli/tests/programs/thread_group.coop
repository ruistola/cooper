# exit: 0
# stdout: all 5 done
# stdout: error: disk full
# stdout: stopped early: true
# stdout: error: none
# stdout: worker handled 2 jobs, then stopped
use {
    std.io,
    std.sync,
    std.threads,
}

func report(e: Maybe string) {
    match e with {
        Some(m) => io.println("error: {m}")
        None => io.println("error: none")
    }
}

func main() {
    # every thread finishes before wait returns
    let group: sync.ThreadGroup
    let finished: sync.Atomic
    for i in 0..5 do group.start(func() {
        threads.sleep(2 * i)
        finished.add(1)
    })
    group.wait()
    io.println("all {finished.load()} done")

    # a failure cancels the rest, which check and stop
    let failing: sync.ThreadGroup
    let steps: sync.Atomic
    failing.start(func() {
        threads.sleep(3)
        failing.fail("disk full")
    })
    for i in 0..3 do failing.start(func() {
        while !failing.cancelled() do {
            steps.add(1)
            threads.sleep(1)
        }
    })
    report(failing.wait())
    io.println("stopped early: {steps.load() < 100}")

    # a group with no failure
    let quiet: sync.ThreadGroup
    quiet.start(func() { threads.yield() })
    report(quiet.wait())

    # a member blocked on a channel stops when the group is cancelled
    let workers: sync.ThreadGroup
    let jobs: sync.Channel i32 = sync.channel(0)
    handled := 0
    workers.start(func() {
        stopped := sync.wrap(workers.cancelledEvent(), func(c: ()): Maybe i32 { return None })
        while sync.wait(sync.choose(jobs.recvEvent(), stopped)) is Some(job) do handled += 1
    })
    jobs.send(1)
    jobs.send(2)
    workers.cancel()
    workers.wait()
    io.println("worker handled {handled} jobs, then stopped")
}
