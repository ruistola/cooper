# exit: 0
# Arrays share their elements: assignment, passing, and slicing all do, with
# `copy()` for an independent copy. Growing changes only the array grown: a slice's
# capacity is its length, so growing a slice copies first and never writes into the
# array it came from, and copies sharing spare capacity never append into the same slot.
# `reserve(n)` makes room for `n` more elements, and a pointer to an array lets a
# function grow the caller's array.
func zero(xs: i32[]) {
    for (i, x) in xs do xs[i] = 0
}

func record(log: i32[]^, entry: i32) {
    log.push(entry)
}

func main(): i32 {
    xs := [0, 1, 2, 4, 8]

    tail := xs[2..]
    tail[0] = 99
    if xs[2] != 99 or tail.length() != 3 or tail[2] != 8 then return 1

    copied := xs[2..].copy()
    copied[0] = -1
    if xs[2] != 99 then return 2

    if xs[..2].length() != 2 or xs[..].length() != 5 then return 3
    if xs[1..=3].length() != 3 or xs[1..=3][2] != 4 then return 4
    if xs[5..].length() != 0 then return 5

    head := xs[0..2]
    head.push(77)
    head[0] = 55
    if xs[2] != 99 or xs[0] != 0 then return 6
    if head[2] != 77 or head[0] != 55 then return 7

    zero(xs[3..])
    if xs[3] != 0 or xs[4] != 0 or xs[2] != 99 then return 8

    # Copies of one array with spare capacity each append their own elements: a push into
    # spare capacity is the first copy's, and a later push through the other copy moves it
    # to fresh storage. `push` gives back the element it appended.
    let roomy: i32[] = []
    roomy.reserve(100)
    same := roomy
    if roomy.push(1) != 1 then return 9
    same.push(2)
    roomy.push(3)
    if roomy[0] != 1 or same[0] != 2 or roomy.length() != 2 or same.length() != 1 then return 9

    let log: i32[] = []
    record(&log, 4)
    record(&log, 5)
    if log.length() != 2 or log[1] != 5 then return 10
    return 0
}
