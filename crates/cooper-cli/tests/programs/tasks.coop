# exit: 0
# stdout: main waits
# stdout: a0 b0 c0 a1 b1 c1 a2 c2
# stdout: arguments are evaluated at the thread: 5 7 x
# stdout: slow after fast
# stdout: handles 1 2 ok
# stdout: 1000 threads counted 2000
# stdout: 50000
# stdout: 3 5 ab
# Threads started with `thread`: they run one at a time, switching where they block (`yield`, `sleep`, a
# `WaitGroup`), in the order they became ready. A `thread` evaluates its function and arguments at once,
# works with functions, methods (a pointer receiver on a local variable keeps that variable), function
# values, and generic functions, and gives a `Thread` handle. A thread's stack is its own, as large as an
# OS thread's (8 MiB, committed as used): here one recurses 50000 frames deep, and a thousand threads exist
# at once.
use {
    std.io.println,
    std.task.{ sleep, yield },
    std.sync.WaitGroup,
}

struct Counter {
    total: i64,
}

(c: Counter^) func add(n: i64) {
    c.total += n
}

func worker(name: string, rounds: i32, wg: WaitGroup^, log: string[]^) {
    for i in 0..rounds do {
        log^ = log^.push("{name}{i}")
        yield()
    }
    wg.done()
}

func show(label: string, a: i32, b: i32, wg: WaitGroup^) {
    println("{label}: {a} {b} x")
    wg.done()
}

func nap(label: string, ms: i64, wg: WaitGroup^, order: string[]^) {
    sleep(ms)
    order^ = order^.push(label)
    wg.done()
}

func count(counter: Counter^, wg: WaitGroup^) {
    counter.add(1)
    yield()
    counter.add(1)
    wg.done()
}

func depth(n: i64): i64 {
    if n == 0 then return 0
    return depth(n - 1) + 1
}

func recurse(result: i64^, wg: WaitGroup^) {
    result^ = depth(50000)
    wg.done()
}

func echo T (value: T, out: T[]^, wg: WaitGroup^) {
    out^ = out^.push(value)
    wg.done()
}

func main() {
    let wg: WaitGroup
    let log: string[]
    wg.add(3)
    thread worker("a", 3, &wg, &log)
    thread worker("b", 2, &wg, &log)
    thread worker("c", 3, &wg, &log)
    println("main waits")
    wg.wait()
    let joined = ""
    for (i, entry) in log do joined += (if i > 0 then " " else "") + entry
    println(joined)

    x := 5
    wg.add(1)
    thread show("arguments are evaluated at the thread", x, x + 2, &wg)
    x = 99
    wg.wait()

    let order: string[]
    wg.add(2)
    thread nap("slow", 40, &wg, &order)
    thread nap("fast", 10, &wg, &order)
    wg.wait()
    println("{order[1]} after {order[0]}")

    # each thread has its own handle, with an id that grows
    wg.add(2)
    first := thread nap("one", 0, &wg, &order)
    second := thread nap("two", 0, &wg, &order)
    wg.wait()
    println("handles 1 2 {if second.id == first.id + 1 and first.id > 0 then "ok" else "wrong"}")

    let counter: Counter
    wg.add(1000)
    for i in 0..1000 do thread count(&counter, &wg)
    wg.wait()
    println("1000 threads counted {counter.total}")

    let deep: i64
    wg.add(1)
    thread recurse(&deep, &wg)
    wg.wait()
    println("{deep}")

    let numbers: i32[]
    let words: string[]
    wg.add(3)
    thread echo(3, &numbers, &wg)
    thread echo(5, &numbers, &wg)
    thread echo("ab", &words, &wg)
    wg.wait()
    println("{numbers[0]} {numbers[1]} {words[0]}")
}
