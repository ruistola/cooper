# exit: 0
# Operators: `and`/`or`/`xor` bitwise on integers (both operands evaluated, no
# short-circuit) and logical on bool, `!` as complement and negation, shifts whose count
# may be any integer type, `%=`, and comparison chains, which evaluate each operand at
# most once, in order, and stop at the first false pair. Each check returns its own
# status on failure.
func trace(log: i32[]^, v: i32): i32 {
    log^ = log^.push(v)
    return v
}

func main(): i32 {
    if (12 and 10) != 8 or (12 or 3) != 15 or (12 xor 10) != 6 then return 1
    if (0b0000_1111 and 0b1111_0000 or 0b0001_0001) != 0b0001_0001 then return 2
    let m: u8 = 0xF0
    if !m != 0x0F or !0 != -1 then return 3
    t := true
    if !(t xor false) or !!t != t then return 4

    if 1 << 2 + 1 != 8 then return 5
    let wide: u64 = 1
    let count: u8 = 40
    if wide << count != 1099511627776 then return 6
    let s: i8 = -16
    let u: u8 = 0x80
    if s >> 2 != -4 or u >> 7 != 1 or u << 1 != 0 then return 7

    x := 17
    x %= 5
    if x != 2 then return 8

    if !(1 < 2 <= 2 < 3) or 3 > 2 > 2 then return 9
    let log: i32[] = []
    if trace(&log, 5) < trace(&log, 1) < trace(&log, 9) then return 10
    if log.length() != 2 then return 11
    if !(trace(&log, 1) <= trace(&log, 2) <= trace(&log, 3)) then return 12
    if log.length() != 5 then return 13
    return 0
}
