# exit: 0
# stdout: attempt 0: no response within 20 ms
# stdout: attempt 1: no response within 20 ms
# stdout: attempt 2: printed hello 2
# stdout: never submitted: hello 1
# stdout: reply abandoned: hello 0
# A print service in the manner of Concurrent ML (after Nikhil Marathe's comparison of Go and Racket). A
# client's `printEvent` is an ordinary event: the caller puts a timeout around it, and `withNack` tells the
# request it was abandoned. A request the service has not accepted yet is withdrawn; a reply nobody waits for
# any longer is dropped. The service sleeps 100 ms per job, so the first two attempts give up.
use {
    std.io,
    std.sync,
    std.threads,
}

struct Request {
    message: string,
    reply: (sync.Channel string)^,
    abandoned: sync.Event (),
}

struct Service {
    requests: sync.Channel Request,
    withdrawn: sync.Channel string,
    dropped: sync.Channel string,
}

func serve(service: Service^) {
    while service.requests.recv() is Some(request) do {
        threads.sleep(100)
        sync.wait(sync.choose(
            request.reply.sendEvent("printed {request.message}"),
            sync.wrap(request.abandoned, func(gone: ()) { service.dropped.send(request.message) }),
        ))
    }
}

func printEvent(service: Service^, message: string): sync.Event string {
    return sync.withNack(func(abandoned: sync.Event ()): sync.Event string {
        let reply: sync.Channel string = sync.channel(0)
        thread submit(service, Request{message: message, reply: &reply, abandoned: abandoned})
        return sync.wrap(reply.recvEvent(), text)
    })
}

func text(m: Maybe string): string {
    return if m is Some(s) then s else ""
}

func submit(service: Service^, request: Request) {
    sync.wait(sync.choose(
        service.requests.sendEvent(request),
        sync.wrap(request.abandoned, func(gone: ()) { service.withdrawn.send(request.message) }),
    ))
}

func main() {
    let service = Service{requests: sync.channel(0), withdrawn: sync.channel(1), dropped: sync.channel(1)}
    thread serve(&service)
    for (i, limit) in [20, 20, 1000] do io.println(sync.wait(sync.choose(
        sync.wrap(printEvent(&service, "hello {i}"), func(reply: string): string { return "attempt {i}: {reply}" }),
        sync.wrap(sync.after(limit), func(late: ()): string { return "attempt {i}: no response within {limit} ms" }),
    )))
    io.println("never submitted: {text(service.withdrawn.recv())}")
    io.println("reply abandoned: {text(service.dropped.recv())}")
}
