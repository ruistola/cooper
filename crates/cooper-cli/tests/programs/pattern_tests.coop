# exit: 0
# stdout: 7 -1
# stdout: big 7
# stdout: odd 7
# stdout: not huge
# stdout: true false
# stdout: 2 3
# stdout: 1,2
# stdout: a
# stdout: 3
# stdout: 7 true 100
# stdout: 100
# stdout: 14
# stdout: 0 1 2
# Pattern tests with `is`: payload extraction, `and` guards, chains, bare booleans,
# struct and tuple patterns, `while` conditions, shadowing, and closure capture.
use {
    std.io.{ print, println },
}

struct Point {
    x: i32,
    y: i32,
}

func find(n: i32): Maybe i32 {
    if n > 0 then return Some(n)
    return None
}

func main() {
    foo := find(7)
    none := find(0)

    # As an expression, extracting a payload with a default.
    x := if foo is Some(x) then x else 0
    y := if none is Some(v) then v else -1
    println("{x} {y}")

    # Further conditions are ordinary `and`, which sees the bindings; `or` can sit inside.
    if foo is Some(v) and v > 5 then println("big {v}")
    if foo is Some(v) and (v < 3 or v > 6) then println("odd {v}")
    if foo is Some(v) and v > 50 then println("huge") else println("not huge")

    # A bare test is a bool.
    let ok: bool = foo is Some(_)
    let no: bool = none is Some(_)
    println("{ok} {no}")

    # Tests chain, each seeing the bindings before it.
    if find(2) is Some(a) and find(a + 1) is Some(b) then println("{a} {b}")

    # Struct, tuple, and integer patterns.
    p := Point{x: 1, y: 2}
    if p is Point{x: px, y: py} then println("{px},{py}")
    t := (1, "a")
    if t is (n, s) and n == 1 then println("{s}")

    # `while` tests before each pass; its bindings are fresh each time, and a closure
    # made in the body keeps its own.
    cur := Maybe.Some(0)
    total := 0
    while cur is Some(k) and k < 3 do {
        cur = Some(k + 1)
        total += k
    }
    println("{total}")

    # A binding shadows an outer variable only where the test held.
    v := 100
    if foo is Some(v) then print("{v} ")
    println("{foo is Some(v) and v == 7} {v}")
    println("{v}")

    if foo is Some(c) then {
        f := func(): i32 { return c * 2 }
        println("{f()}")
    }

    # Each pass's binding is its own variable.
    count := Maybe.Some(0)
    let fs: i32[] = []
    while count is Some(i) and i < 3 do {
        fs = fs.push(i)
        count = Some(i + 1)
    }
    println("{fs[0]} {fs[1]} {fs[2]}")
}
