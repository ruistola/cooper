# exit: 101
# stderr: panic: stack overflow in thread
# env: COOPER_STACK_KIB=96
# A frame of several large locals, bigger than the whole stack, must be caught as a stack overflow:
# without probing the frame a page at a time, the first access could land beyond the guard page, in
# memory that belongs to something else.
use {
    std.io.println,
    std.sync.WaitGroup,
}

extern func getpid(): i32

# The indexes depend on the process id, so that an optimized build keeps the arrays.
func spread(): i64 {
    let a: i64[40000]
    let b: i64[40000]
    let c: i64[40000]
    i := i64(getpid()) % 40000
    j := i64(getpid()) * 7 % 40000
    b[i] = 1
    c[i] = 2
    a[i] = 3
    return a[j] + b[j] + c[j]
}

func run(wg: WaitGroup^) {
    println("{spread()}")
    wg.done()
}

func main() {
    let wg: WaitGroup
    wg.add(1)
    thread run(&wg)
    wg.wait()
}
