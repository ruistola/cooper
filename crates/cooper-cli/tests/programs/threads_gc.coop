# exit: 0
# stdout: 8 threads hold 120 strings and 8 lists
# stdout: lists sum 696
# Each thread keeps its data only on its own stack (a local array of strings and a linked list) while
# it is suspended and the others allocate a great deal. The collector must scan every thread's stack,
# not just the running one's: the data must come back intact. (The harness also runs this collecting
# at every allocation.)
use {
    std.io.println,
    std.threads.yield,
    std.sync.{ Atomic, WaitGroup },
}

struct Node {
    value: i64,
    next: Node^,
}

func build(n: i64): Node^ {
    let first: Node^
    for i in 0..n do {
        let node: Node = Node{value: i, next: first}
        first = &node
    }
    return first
}

func total(list: Node^): i64 {
    let sum: i64 = 0
    while list != nil do {
        sum += list.value
        list = list.next
    }
    return sum
}

func holder(id: i32, wg: WaitGroup^, strings: Atomic^, sums: Atomic^) {
    let mine: string[]
    for i in 0..15 do mine = mine.push("thread {id} holds string number {i} of its own")
    let list = build(10 + i64(id))
    for round in 0..6 do yield()
    for (i, s) in mine do {
        if s != "thread {id} holds string number {i} of its own" then strings.add(-1000000)
    }
    strings.add(i64(mine.length()))
    sums.add(total(list))
    wg.done()
}

func churn(wg: WaitGroup^) {
    for round in 0..300 do {
        let junk: string[]
        for j in 0..20 do junk = junk.push("garbage {round} {j} padded out to a reasonable length")
        yield()
    }
    wg.done()
}

func main() {
    let wg: WaitGroup
    let strings: Atomic
    let sums: Atomic
    wg.add(10)
    for id in 0..8 do thread holder(id, &wg, &strings, &sums)
    thread churn(&wg)
    thread churn(&wg)
    wg.wait()
    println("8 threads hold {strings.load()} strings and 8 lists")
    println("lists sum {sums.load()}")
}
