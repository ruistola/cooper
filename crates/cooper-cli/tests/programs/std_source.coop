# exit: 0
# stdout: a, b, c
# stdout: |
# stdout: x-y
# A standard library module written in Cooper (`std.strings`), compiled with the program
# that uses it, by module or by name. Functions `main` never reaches are not compiled.
use {
    std.io.println,
    std.strings as strings,
    std.strings.join,
}

func unused() {
    println("never compiled")
}

func main() {
    println(strings.join(["a", "b", "c"], ", "))
    println(strings.join([], "-") + "|")
    println(join(["x", "y"], "-"))
}
