# The standard `testing` module: assertions for the tests `cooper test` runs.
#
# A test is a function `testName()` in a `*_test.coop` file. It passes if it returns and fails if
# it calls `fail`, or a `check` that does not hold, or panics. Each test runs in a process of its
# own, so a failure stops that test and no other.

use {
    std.io.eprintln,
}

extern func exit(status: i32)

# Fails the test, saying `message`. A call to `fail` or `check` also reports where it was
# written: the compiler passes that location to `failAt` and `checkAt`.
func fail(message: string) {
    failAt(message, "unknown location")
}

# Fails the test with `message` unless `ok` holds.
func check(ok: bool, message: string) {
    checkAt(ok, message, "unknown location")
}

# `fail`, told where it was called from.
func failAt(message: string, at: string) {
    eprintln("FAIL: " + message + "\n      at " + at)
    exit(1)
}

# `check`, told where it was called from.
func checkAt(ok: bool, message: string, at: string) {
    if !ok then failAt(message, at)
}
