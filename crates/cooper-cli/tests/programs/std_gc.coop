# exit: 0
# stdout: the default growth is 100: true
# stdout: collections while off: 0
# stdout: collect ran one: true
# stdout: the garbage is gone: true
# stdout: collections with growth back on: true
# stdout: pauses counted: true
# env: COOPER_GC=
# std.gc turns automatic collection off and on and collects on request. The stress modes collect whatever the
# setting, so this program runs without them.
use {
    std.gc as gc,
    std.io.println,
}

# Allocates about `mib` MiB, none of which survives.
func churn(mib: i64) {
    for i in 0..mib * 1024 do {
        let xs: i64[]
        for j in 0..128 do xs.push(j)
    }
}

func main() {
    previous := gc.setGrowth(None)
    println("the default growth is 100: {previous is Some(p) and p == 100}")
    off := gc.stats()
    churn(64)
    println("collections while off: {gc.stats().collections - off.collections}")

    gc.collect()
    collected := gc.stats()
    println("collect ran one: {collected.collections == off.collections + 1}")
    println("the garbage is gone: {collected.live < 1048576 and collected.allocated > 64 * 1048576}")

    gc.setGrowth(previous)
    churn(64)
    println("collections with growth back on: {gc.stats().collections > collected.collections}")
    println("pauses counted: {collected.pauses >= 2 and collected.longestPause > 0}")
}
